variable "net_hub_project_id" {
  description = "Network hub project from Week 01. Holds the existing hub VPC and everything this week adds."
  type        = string
}

variable "region" {
  description = "Region for both VPN gateways, both Cloud Routers and the test VMs."
  type        = string
  default     = "us-central1"
}

variable "branch_cidr" {
  description = "Subnet for the simulated remote site. Must not overlap the hub's 10.20.0.0/24 or 10.20.1.0/24 - BGP advertises these ranges and an overlap makes the route ambiguous."
  type        = string
  default     = "10.30.0.0/24"
}

variable "hub_asn" {
  description = "BGP ASN for the hub Cloud Router. Private range is 64512-65534."
  type        = number
  default     = 64512
}

variable "branch_asn" {
  description = "BGP ASN for the branch Cloud Router. Must differ from hub_asn - identical ASNs on both ends make this an iBGP session, which does not re-advertise learned routes the way this topology needs."
  type        = number
  default     = 64513
}

variable "shared_secret" {
  description = "IKE pre-shared key for all four tunnels. Gitignored; generated by scripts/gen-psk.sh."
  type        = string
  sensitive   = true
}
